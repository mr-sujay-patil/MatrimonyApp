{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoardConfig",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "bgHex": { "type": "string" },
          "dotColor": { "type": "string" },
          "wipLimit": { "type": "number" }
        },
        "required": ["id", "title", "bgHex", "dotColor"]
      }
    }
  },
  "required": ["columns"]
}
